<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="pl.demo.ice.db">
  <class name="User" table="users">
    <id name="id" column="id" type="long">
      <generator class="identity"/>
    </id>
    <property name="login" column="login" type="string" not-null="true" unique="true" length="80"/>
    <property name="haslo" column="haslo" type="string" not-null="true" length="255"/>
    <property name="imie" column="imie" type="string" not-null="true" length="100"/>
    <property name="nazwisko" column="nazwisko" type="string" not-null="true" length="100"/>
  </class>
</hibernate-mapping>
