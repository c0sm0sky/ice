<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="pl.demo.ice.db">
  <class name="Report" table="reports">
    <id name="id" column="id"><generator class="native" /></id>
    <property name="code" column="code" not-null="true" unique="true" length="80" />
    <property name="title" column="title" />
    <property name="description" column="description" length="255" />
    <many-to-one name="owner" class="User" column="owner_id" not-null="true" />
  </class>
</hibernate-mapping>
