<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pl.demo</groupId>
  <artifactId>ice</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>
  <name>Ice</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <spring.version>2.0.6</spring.version>
    <spring-webflow.version>1.0.5</spring-webflow.version>
    <hibernate.version>3.6.10.Final</hibernate.version>
    <icefaces.version>1.8.2</icefaces.version>
    <myfaces.version>1.1.10</myfaces.version>
    <postgresql.version>42.7.5</postgresql.version>
    <servlet-api.version>2.5</servlet-api.version>
    <javassist.version>3.12.0.GA</javassist.version>
    <commons-dbcp.version>1.4</commons-dbcp.version>
    <maven-clean-plugin.version>2.5</maven-clean-plugin.version>
    <maven-compiler-plugin.version>2.3.2</maven-compiler-plugin.version>
    <maven-war-plugin.version>2.1.1</maven-war-plugin.version>
  </properties>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-core</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-beans</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-context</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-aop</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-web</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-webmvc</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-jdbc</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-dao</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-hibernate3</artifactId>
        <version>${spring.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.icefaces</groupId>
      <artifactId>icefaces</artifactId>
      <version>${icefaces.version}</version>
    </dependency>
    <dependency>
      <groupId>org.icefaces</groupId>
      <artifactId>icefaces-comps</artifactId>
      <version>${icefaces.version}</version>
    </dependency>
    <dependency>
      <groupId>org.icefaces</groupId>
      <artifactId>icefaces-facelets</artifactId>
      <version>${icefaces.version}</version>
      <exclusions>
        <exclusion>
          <groupId>javax.el</groupId>
          <artifactId>el-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.apache.myfaces.core</groupId>
      <artifactId>myfaces-api</artifactId>
      <version>${myfaces.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.myfaces.core</groupId>
      <artifactId>myfaces-impl</artifactId>
      <version>${myfaces.version}</version>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>servlet-api</artifactId>
      <version>${servlet-api.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webflow</artifactId>
      <version>${spring-webflow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-dao</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-hibernate3</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.hibernate</groupId>
          <artifactId>hibernate</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>${hibernate.version}</version>
    </dependency>
    <dependency>
      <groupId>javassist</groupId>
      <artifactId>javassist</artifactId>
      <version>${javassist.version}</version>
    </dependency>
    <dependency>
      <groupId>commons-dbcp</groupId>
      <artifactId>commons-dbcp</artifactId>
      <version>${commons-dbcp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>

  </dependencies>

  <build>
    <finalName>ice</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven-clean-plugin.version}</version>
        <configuration>
          <filesets>
            <fileset>
              <directory>${project.basedir}/primefaces-migrated.staging</directory>
              <followSymlinks>false</followSymlinks>
            </fileset>
          </filesets>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>${maven-war-plugin.version}</version>
        <configuration>
          <failOnMissingWebXml>true</failOnMissingWebXml>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>primefaces-migration</id>
      <properties>
        <migration.java.version>25</migration.java.version>
        <migration.primefaces.version>16.0.2</migration.primefaces.version>
        <migration.spring.version>7.0.10</migration.spring.version>
        <migration.spring-webflow.version>4.0.1</migration.spring-webflow.version>
        <migration.hibernate.version>7.4.16.Final</migration.hibernate.version>
        <migration.postgresql.version>42.7.14</migration.postgresql.version>
        <migration.jakarta-faces.version>4.1.1</migration.jakarta-faces.version>
        <migration.jakarta-servlet.version>6.1.0</migration.jakarta-servlet.version>
        <migration.commons-dbcp.version>2.14.0</migration.commons-dbcp.version>
        <migration.maven-compiler-plugin.version>3.14.1</migration.maven-compiler-plugin.version>
        <migration.maven-war-plugin.version>3.5.1</migration.maven-war-plugin.version>
        <migration.maven-clean-plugin.version>3.5.0</migration.maven-clean-plugin.version>
        <migration.maven-install-plugin.version>3.1.4</migration.maven-install-plugin.version>
        <migration.maven-dependency-plugin.version>3.11.0</migration.maven-dependency-plugin.version>
        <migration.webflow-upgrader.version>2.0.6.RELEASE</migration.webflow-upgrader.version>
        <migration.rewrite-plugin.version>6.46.1</migration.rewrite-plugin.version>
        <migration.rewrite-migrate-java.version>3.42.1</migration.rewrite-migrate-java.version>
        <rewrite.activeRecipes>pl.demo.ice.migrate.IceToPrimeFaces</rewrite.activeRecipes>
        <rewrite.recipeArtifactCoordinates>org.openrewrite.recipe:rewrite-migrate-java:${migration.rewrite-migrate-java.version}</rewrite.recipeArtifactCoordinates>
        <migration.junit.version>6.1.3</migration.junit.version>
        <migration.cdi.version>4.1.0</migration.cdi.version>
        <migration.maven-antrun-plugin.version>3.2.0</migration.maven-antrun-plugin.version>
        <migration.maven-surefire-plugin.version>3.6.1</migration.maven-surefire-plugin.version>
        <migration.maven-build-helper-plugin.version>3.6.1</migration.maven-build-helper-plugin.version>
        <migration.maven-enforcer-plugin.version>1.0.1</migration.maven-enforcer-plugin.version>
        <primefaces.migration.output.dir>${project.basedir}/primefaces-migrated</primefaces.migration.output.dir>
        <primefaces.migration.staging.dir>${project.basedir}/primefaces-migrated.staging</primefaces.migration.staging.dir>
        <primefaces.migration.backup.dir>${project.basedir}/primefaces-migrated.previous</primefaces.migration.backup.dir>
        <primefaces.migration.staged>false</primefaces.migration.staged>
        <primefaces.migration.skip-local-compile>false</primefaces.migration.skip-local-compile>
        <primefaces.migration.skip-local-war>true</primefaces.migration.skip-local-war>
        <primefaces.migration.skip-local-install>true</primefaces.migration.skip-local-install>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter</artifactId>
          <version>${migration.junit.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.junit.vintage</groupId>
          <artifactId>junit-vintage-engine</artifactId>
          <version>${migration.junit.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.glassfish</groupId>
          <artifactId>jakarta.faces</artifactId>
          <version>${migration.jakarta-faces.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>jakarta.enterprise</groupId>
          <artifactId>jakarta.enterprise.cdi-api</artifactId>
          <version>${migration.cdi.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>jakarta.enterprise</groupId>
          <artifactId>jakarta.enterprise.cdi-el-api</artifactId>
          <version>${migration.cdi.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${migration.maven-surefire-plugin.version}</version>
            <configuration>
              <includes>
                <include>**/FlowMigrationDefinitionTest.java</include>
              </includes>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>${migration.maven-build-helper-plugin.version}</version>
            <executions>
              <execution>
                <id>add-primefaces-migration-tests</id>
                <phase>generate-test-sources</phase>
                <goals><goal>add-test-source</goal></goals>
                <configuration>
                  <sources><source>src/test/primefaces-migration/java</source></sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>${migration.maven-dependency-plugin.version}</version>
            <executions>
              <execution>
                <id>prepare-webflow-upgrader</id>
                <phase>initialize</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <skip>${primefaces.migration.staged}</skip>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.springframework.webflow</groupId>
                      <artifactId>spring-webflow</artifactId>
                      <version>${migration.webflow-upgrader.version}</version>
                      <outputDirectory>${project.build.directory}/migration-tools</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.springframework</groupId>
                      <artifactId>spring-core</artifactId>
                      <version>${migration.spring.version}</version>
                      <outputDirectory>${project.build.directory}/migration-tools</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>${migration.maven-clean-plugin.version}</version>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>${migration.maven-antrun-plugin.version}</version>
            <executions>
              <execution>
                <id>build-migrated-prime-war</id>
                <phase>initialize</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <skip>${primefaces.migration.staged}</skip>
                  <target>
                    <tempfile property="migration.work.dir" destDir="${java.io.tmpdir}"
                              prefix="ice-primefaces-migration-" createFile="false"/>
                    <mkdir dir="${migration.work.dir}"/>
                    <copy todir="${migration.work.dir}">
                      <fileset dir="${project.basedir}"
                               excludes="target/**,primefaces-migrated/**,.git/**,.idea/**"/>
                    </copy>
                    <mkdir dir="${migration.work.dir}/target"/>
                    <mkdir dir="${project.build.directory}/migration-artifacts"/>
                    <echo message="Running Spring WebFlowUpgrader on main-flow.xml"/>
                    <java classname="org.springframework.webflow.upgrade.WebFlowUpgrader"
                          fork="true" failonerror="true"
                          output="${migration.work.dir}/target/main-flow-upgraded.xml">
                      <classpath>
                        <pathelement location="${project.build.directory}/migration-tools/spring-webflow-${migration.webflow-upgrader.version}.jar"/>
                        <pathelement location="${project.build.directory}/migration-tools/spring-core-${migration.spring.version}.jar"/>
                      </classpath>
                      <arg value="${migration.work.dir}/src/main/webapp/WEB-INF/flows/main-flow.xml"/>
                    </java>
                    <copy file="${migration.work.dir}/target/main-flow-upgraded.xml"
                          tofile="${project.build.directory}/migration-artifacts/main-flow-upgraded.xml"/>
                    <echo message="WebFlowUpgrader output retained at ${project.build.directory}/migration-artifacts/main-flow-upgraded.xml"/>
                    <move file="${migration.work.dir}/target/main-flow-upgraded.xml"
                          tofile="${migration.work.dir}/src/main/webapp/WEB-INF/flows/main-flow.xml"
                          overwrite="true"/>
                    <exec executable="mvn" dir="${migration.work.dir}" failonerror="true">
                      <arg value="-f"/>
                      <arg value="${migration.work.dir}/pom.xml"/>
                      <arg value="-Dmaven.multiModuleProjectDirectory=${migration.work.dir}"/>
                      <arg value="-Dprimefaces.migration.staged=true"/>
                      <arg value="-Pprimefaces-migration"/>
                      <arg value="rewrite:dryRunNoFork"/>
                    </exec>
                    <mkdir dir="${project.build.directory}/rewrite"/>
                    <copy file="${migration.work.dir}/target/rewrite/rewrite.patch"
                          tofile="${project.build.directory}/rewrite/rewrite.patch" overwrite="true"/>
                    <exec executable="patch" dir="${migration.work.dir}" failonerror="true">
                      <arg value="--dry-run"/>
                      <arg value="-p1"/>
                      <arg value="-i"/>
                      <arg value="${migration.work.dir}/target/rewrite/rewrite.patch"/>
                    </exec>
                    <exec executable="patch" dir="${migration.work.dir}" failonerror="true">
                      <arg value="-p1"/>
                      <arg value="-i"/>
                      <arg value="${migration.work.dir}/target/rewrite/rewrite.patch"/>
                    </exec>
                    <exec executable="mvn" dir="${migration.work.dir}" failonerror="true">
                      <arg value="-f"/>
                      <arg value="${migration.work.dir}/pom.xml"/>
                      <arg value="-Dmaven.multiModuleProjectDirectory=${migration.work.dir}"/>
                      <arg value="-Dprimefaces.migration.staged=true"/>
                      <arg value="-Drewrite.activeRecipes=pl.demo.ice.migrate.PrimeFacesPomChanges"/>
                      <arg value="-Pprimefaces-migration"/>
                      <arg value="rewrite:dryRunNoFork"/>
                    </exec>
                    <copy file="${migration.work.dir}/target/rewrite/rewrite.patch"
                          tofile="${project.build.directory}/rewrite/primefaces-pom-changes.patch" overwrite="true"/>
                    <exec executable="patch" dir="${migration.work.dir}" failonerror="true">
                      <arg value="--dry-run"/>
                      <arg value="-p1"/>
                      <arg value="-i"/>
                      <arg value="${migration.work.dir}/target/rewrite/rewrite.patch"/>
                    </exec>
                    <exec executable="patch" dir="${migration.work.dir}" failonerror="true">
                      <arg value="-p1"/>
                      <arg value="-i"/>
                      <arg value="${migration.work.dir}/target/rewrite/rewrite.patch"/>
                    </exec>
                    <exec executable="test" dir="${migration.work.dir}" failonerror="true">
                      <arg value="!"/>
                      <arg value="-s"/>
                      <arg value="src/main/webapp/WEB-INF/faces-config.xml"/>
                    </exec>
                    <delete file="${migration.work.dir}/src/main/webapp/WEB-INF/faces-config.xml"/>
                    <delete dir="${primefaces.migration.staging.dir}" quiet="true"/>
                    <copy todir="${primefaces.migration.staging.dir}">
                      <fileset dir="${migration.work.dir}"
                               excludes="target/**,rewrite.yml,README.md,src/test/primefaces-migration/**"/>
                    </copy>
                    <exec executable="mvn" dir="${primefaces.migration.staging.dir}" failonerror="true">
                      <arg value="-f"/>
                      <arg value="${primefaces.migration.staging.dir}/pom.xml"/>
                      <arg value="clean"/>
                      <arg value="package"/>
                    </exec>
                    <copy todir="${primefaces.migration.output.dir}">
                      <fileset dir="${primefaces.migration.staging.dir}"/>
                    </copy>
                    <available file="${primefaces.migration.output.dir}/target/prime.war"
                               property="migration.new.war.exists"/>
                    <fail unless="migration.new.war.exists"
                          message="Migrated project published without target/prime.war"/>
                    <delete dir="${primefaces.migration.staging.dir}" quiet="true"/>
                    <delete dir="${migration.work.dir}" quiet="true"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>${migration.maven-compiler-plugin.version}</version>
            <configuration>
              <skipMain>${primefaces.migration.skip-local-compile}</skipMain>
              <skip>${primefaces.migration.skip-local-compile}</skip>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-war-plugin</artifactId>
            <version>${migration.maven-war-plugin.version}</version>
            <configuration>
              <failOnMissingWebXml>true</failOnMissingWebXml>
              <skip>${primefaces.migration.skip-local-war}</skip>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-install-plugin</artifactId>
            <version>${migration.maven-install-plugin.version}</version>
            <configuration>
              <skip>${primefaces.migration.skip-local-install}</skip>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>${migration.rewrite-plugin.version}</version>
            <configuration>
              <activeRecipes>
                <recipe>${rewrite.activeRecipes}</recipe>
              </activeRecipes>
              <configLocation>${maven.multiModuleProjectDirectory}/rewrite.yml</configLocation>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <exportDatatables>true</exportDatatables>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>org.openrewrite.recipe</groupId>
                <artifactId>rewrite-migrate-java</artifactId>
                <version>${migration.rewrite-migrate-java.version}</version>
              </dependency>
            </dependencies>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>${migration.maven-enforcer-plugin.version}</version>
            <executions>
              <execution>
                <id>require-modern-maven-for-migration</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[25,26)</version>
                      <message>The primefaces-migration profile requires JDK 25.</message>
                    </requireJavaVersion>
                    <requireMavenVersion>
                      <version>[3.6.3,)</version>
                      <message>The primefaces-migration profile requires Maven 3.6.3 or newer.</message>
                    </requireMavenVersion>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
