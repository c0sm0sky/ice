<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pl.demo</groupId>
  <artifactId>ice</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>
  <name>Ice</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <spring.version>2.0.6</spring.version>
    <spring-webflow.version>1.0.5</spring-webflow.version>
    <hibernate.version>3.6.10.Final</hibernate.version>
    <icefaces.version>1.8.2</icefaces.version>
    <myfaces.version>1.1.10</myfaces.version>
    <postgresql.version>42.7.5</postgresql.version>

    <migration.java.version>25</migration.java.version>
    <migration.primefaces.version>16.0.2</migration.primefaces.version>
    <migration.spring.version>7.0.10</migration.spring.version>
    <migration.spring-webflow.version>4.0.1</migration.spring-webflow.version>
    <migration.hibernate.version>7.4.16.Final</migration.hibernate.version>
    <migration.postgresql.version>42.7.14</migration.postgresql.version>
    <migration.jakarta-faces.version>4.1.1</migration.jakarta-faces.version>
    <migration.jakarta-servlet.version>6.1.0</migration.jakarta-servlet.version>
    <migration.commons-dbcp.version>2.14.0</migration.commons-dbcp.version>
    <migration.maven-compiler-plugin.version>3.14.1</migration.maven-compiler-plugin.version>
    <migration.maven-war-plugin.version>3.5.1</migration.maven-war-plugin.version>
    <migration.maven-clean-plugin.version>3.5.0</migration.maven-clean-plugin.version>
    <migration.maven-install-plugin.version>3.1.4</migration.maven-install-plugin.version>
    <migration.rewrite-plugin.version>6.46.1</migration.rewrite-plugin.version>
    <migration.rewrite-migrate-java.version>3.42.1</migration.rewrite-migrate-java.version>
  </properties>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-core</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-beans</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-context</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-aop</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-web</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-webmvc</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-jdbc</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-dao</artifactId>
        <version>${spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-hibernate3</artifactId>
        <version>${spring.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.icefaces</groupId>
      <artifactId>icefaces</artifactId>
      <version>${icefaces.version}</version>
    </dependency>
    <dependency>
      <groupId>org.icefaces</groupId>
      <artifactId>icefaces-comps</artifactId>
      <version>${icefaces.version}</version>
    </dependency>
    <dependency>
      <groupId>org.icefaces</groupId>
      <artifactId>icefaces-facelets</artifactId>
      <version>${icefaces.version}</version>
      <exclusions>
        <exclusion>
          <groupId>javax.el</groupId>
          <artifactId>el-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.apache.myfaces.core</groupId>
      <artifactId>myfaces-api</artifactId>
      <version>${myfaces.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.myfaces.core</groupId>
      <artifactId>myfaces-impl</artifactId>
      <version>${myfaces.version}</version>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>servlet-api</artifactId>
      <version>2.5</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webflow</artifactId>
      <version>${spring-webflow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-dao</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-hibernate3</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.hibernate</groupId>
          <artifactId>hibernate</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>${hibernate.version}</version>
    </dependency>
    <dependency>
      <groupId>javassist</groupId>
      <artifactId>javassist</artifactId>
      <version>3.12.0.GA</version>
    </dependency>
    <dependency>
      <groupId>commons-dbcp</groupId>
      <artifactId>commons-dbcp</artifactId>
      <version>1.4</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>

  </dependencies>

  <build>
    <finalName>prime</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>2.3.2</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>2.1.1</version>
        <configuration>
          <failOnMissingWebXml>true</failOnMissingWebXml>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>primefaces-migration</id>
      <properties>
        <rewrite.activeRecipes>pl.demo.ice.migrate.IceToPrimeFaces</rewrite.activeRecipes>
        <rewrite.recipeArtifactCoordinates>org.openrewrite.recipe:rewrite-migrate-java:3.42.1</rewrite.recipeArtifactCoordinates>
        <migration.junit.version>6.1.3</migration.junit.version>
        <migration.cdi.version>4.1.0</migration.cdi.version>
        <migration.maven-antrun-plugin.version>3.2.0</migration.maven-antrun-plugin.version>
        <primefaces.migration.staged>false</primefaces.migration.staged>
        <primefaces.migration.skip-local-compile>true</primefaces.migration.skip-local-compile>
        <primefaces.migration.skip-local-war>true</primefaces.migration.skip-local-war>
        <primefaces.migration.skip-local-install>true</primefaces.migration.skip-local-install>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter</artifactId>
          <version>${migration.junit.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.glassfish</groupId>
          <artifactId>jakarta.faces</artifactId>
          <version>${migration.jakarta-faces.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>jakarta.enterprise</groupId>
          <artifactId>jakarta.enterprise.cdi-api</artifactId>
          <version>${migration.cdi.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>jakarta.enterprise</groupId>
          <artifactId>jakarta.enterprise.cdi-el-api</artifactId>
          <version>${migration.cdi.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-primefaces-migration-tests</id>
                <phase>generate-test-sources</phase>
                <goals><goal>add-test-source</goal></goals>
                <configuration>
                  <sources><source>src/test/primefaces-migration/java</source></sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>${migration.maven-clean-plugin.version}</version>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>${migration.maven-antrun-plugin.version}</version>
            <executions>
              <execution>
                <id>build-migrated-prime-war</id>
                <phase>initialize</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <skip>${primefaces.migration.staged}</skip>
                  <target>
                    <property name="migration.work.dir" location="${project.build.directory}/primefaces-migration"/>
                    <mkdir dir="${migration.work.dir}"/>
                    <copy todir="${migration.work.dir}">
                      <fileset dir="${project.basedir}">
                        <include name="pom.xml"/>
                        <include name="rewrite.yml"/>
                        <include name="src/**"/>
                      </fileset>
                    </copy>
                    <exec executable="mvn" dir="${project.basedir}" failonerror="true">
                      <arg value="-Dprimefaces.migration.staged=true"/>
                      <arg value="-Pprimefaces-migration"/>
                      <arg value="rewrite:dryRunNoFork"/>
                    </exec>
                    <exec executable="patch" dir="${migration.work.dir}" failonerror="true">
                      <arg value="--dry-run"/>
                      <arg value="-p1"/>
                      <arg value="-i"/>
                      <arg value="${project.build.directory}/rewrite/rewrite.patch"/>
                    </exec>
                    <exec executable="patch" dir="${migration.work.dir}" failonerror="true">
                      <arg value="-p1"/>
                      <arg value="-i"/>
                      <arg value="${project.build.directory}/rewrite/rewrite.patch"/>
                    </exec>
                    <delete file="${migration.work.dir}/src/main/webapp/WEB-INF/faces-config.xml"/>
                    <exec executable="mvn" dir="${migration.work.dir}" failonerror="true">
                      <arg value="-Dprimefaces.migration.staged=true"/>
                      <arg value="-Dprimefaces.migration.skip-local-compile=false"/>
                      <arg value="-Dprimefaces.migration.skip-local-war=false"/>
                      <arg value="-Dprimefaces.migration.skip-local-install=false"/>
                      <arg value="-Pprimefaces-migration"/>
                      <arg value="clean"/>
                      <arg value="install"/>
                    </exec>
                    <copy file="${migration.work.dir}/target/prime.war"
                          tofile="${project.build.directory}/prime.war" overwrite="true"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>${migration.maven-compiler-plugin.version}</version>
            <configuration>
              <skipMain>${primefaces.migration.skip-local-compile}</skipMain>
              <skip>${primefaces.migration.skip-local-compile}</skip>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-war-plugin</artifactId>
            <version>${migration.maven-war-plugin.version}</version>
            <configuration>
              <failOnMissingWebXml>true</failOnMissingWebXml>
              <skip>${primefaces.migration.skip-local-war}</skip>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-install-plugin</artifactId>
            <version>${migration.maven-install-plugin.version}</version>
            <configuration>
              <skip>${primefaces.migration.skip-local-install}</skip>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>${migration.rewrite-plugin.version}</version>
            <configuration>
              <activeRecipes>
                <recipe>pl.demo.ice.migrate.IceToPrimeFaces</recipe>
              </activeRecipes>
              <configLocation>${maven.multiModuleProjectDirectory}/rewrite.yml</configLocation>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <exportDatatables>true</exportDatatables>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>org.openrewrite.recipe</groupId>
                <artifactId>rewrite-migrate-java</artifactId>
                <version>${migration.rewrite-migrate-java.version}</version>
              </dependency>
            </dependencies>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>1.0.1</version>
            <executions>
              <execution>
                <id>require-modern-maven-for-migration</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[25,26)</version>
                      <message>The primefaces-migration profile requires JDK 25.</message>
                    </requireJavaVersion>
                    <requireMavenVersion>
                      <version>[3.6.3,)</version>
                      <message>The primefaces-migration profile requires Maven 3.6.3 or newer.</message>
                    </requireMavenVersion>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
